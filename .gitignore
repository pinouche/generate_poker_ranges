# Solver output. A single dump_rounds 2 board is ~80MB and a full scenario is ~15GB,
# so this must never enter history -- it is regenerable by generate_charts.py.
resources/outputs/

# Solver binaries and their bundled lookup tables, shipped with TexasSolver rather
